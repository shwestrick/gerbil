#!/usr/bin/env bash
# gerbil -- installable launcher for the sandboxed Lean theorem-proving agent.
#
# Install: copy this single file onto your PATH (it is self-contained; the
# gerbil source is fetched on first use). For example:
#   curl -fsSL https://raw.githubusercontent.com/shwestrick/gerbil/main/bin/gerbil \
#       -o ~/.local/bin/gerbil && chmod +x ~/.local/bin/gerbil
#
# Commands:
#   gerbil run [--prompt FILE] [--at DIR] [--ralph N] ...   run a session
#   gerbil new-fill [--at DIR] ...                          author a fill-sorry task
#                                                           in $EDITOR, then run it
#   gerbil resume SESSION_FILE [--at DIR] ...                continue a crashed session
#   gerbil commit [--at DIR]                                git am the patches
#   gerbil cleanup [--at DIR]                               delete committed patches
#   gerbil summarize [--at DIR]                             token/cost/tool stats
#   gerbil reconstruct-patch SESSION_FILE [--at DIR]        rebuild a .patch
#   gerbil ps                                               list background runs
#   gerbil grab [NAME]                                      reattach a background run
#   gerbil update                                           update to latest main (+ self)
#   gerbil --version                                        show current version
#
# The source is kept under ~/.gerbil/versions/<commit>/ and run with `uv`.
# Requires: git, uv, and a container runtime (docker, or podman when
# GERBIL_SANDBOX=podman).
set -euo pipefail

GERBIL_HOME="${GERBIL_HOME:-$HOME/.gerbil}"
REPO_URL="${GERBIL_REPO_URL:-https://github.com/shwestrick/gerbil}"
REPO_DIR="$GERBIL_HOME/repo"            # cache clone, used for fetching
VERSIONS_DIR="$GERBIL_HOME/versions"    # versions/<commit>/ source checkouts
CURRENT_FILE="$GERBIL_HOME/current"     # holds the active commit hash

die() { echo "gerbil: $*" >&2; exit 1; }

# Container runtime: docker (default) or podman, chosen with GERBIL_SANDBOX --
# the same variable the Python side reads (see src/gerbil/runtime.py), so the
# image the launcher builds always lands in the engine that will run it.
# CTR is the command prefix; podman is muzzled to errors because it warns
# chattily (e.g. about an NFS-backed graph root) on every invocation.
SANDBOX_RUNTIME="${GERBIL_SANDBOX:-docker}"
case "$SANDBOX_RUNTIME" in
    docker) CTR=(docker) ;;
    podman) CTR=(podman --log-level=error) ;;
    *) die "GERBIL_SANDBOX must be 'docker' or 'podman' (got '$SANDBOX_RUNTIME')" ;;
esac

ensure_repo() {
    command -v git >/dev/null || die "git is required"
    command -v uv  >/dev/null || die "uv is required (https://astral.sh/uv)"
    if [ ! -d "$REPO_DIR/.git" ]; then
        mkdir -p "$GERBIL_HOME"
        git clone -q "$REPO_URL" "$REPO_DIR"
    fi
}

# Materialize versions/<hash> as an independent checkout of the cache clone.
ensure_version() {
    local hash="$1" vdir="$VERSIONS_DIR/$hash"
    if [ ! -d "$vdir" ]; then
        mkdir -p "$VERSIONS_DIR"
        git clone -q "$REPO_DIR" "$vdir"
        git -C "$vdir" checkout -q "$hash"
    fi
}

# Fetch latest main, materialize it, and make it current. Echoes the hash.
set_current_to_main() {
    ensure_repo
    git -C "$REPO_DIR" fetch -q origin main
    local hash
    hash="$(git -C "$REPO_DIR" rev-parse origin/main)"
    ensure_version "$hash"
    echo "$hash" > "$CURRENT_FILE"
    echo "$hash"
}

bootstrap_if_needed() {
    if [ ! -s "$CURRENT_FILE" ]; then
        echo "gerbil: first run -- fetching source from $REPO_URL" >&2
        set_current_to_main >/dev/null
    fi
}

current_dir() { echo "$VERSIONS_DIR/$(cat "$CURRENT_FILE")"; }

# The uid the sandbox image runs as (see src/lean-sandbox/Dockerfile), and the
# image tag that goes with it. Both are set by ensure_image, which every
# container-using command calls first.
SANDBOX_UID=1000
SANDBOX_IMAGE=""

# Normally the image runs as the non-root `gerbil` user, uid 1000. Rootless
# podman can only do that if this account has a /etc/subuid range covering that
# uid: with the single mapped uid a bare rootless setup gets, the build cannot
# chown to 1000 and the runtime cannot map it (`crun: setresgid to '1000':
# Invalid argument`). Rather than requiring an administrator to hand out a subuid
# range, fall back to an image that runs as container-root -- which rootless
# podman maps straight back to this unprivileged user, so nothing on the host
# gains privilege. Docker and rootful podman always get the non-root image.
detect_sandbox_uid() {
    [ "$SANDBOX_RUNTIME" = podman ] || { echo 1000; return; }
    [ "$("${CTR[@]}" info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" = "true" ] \
        || { echo 1000; return; }
    if "${CTR[@]}" info \
            --format '{{range .Host.IDMappings.UIDMap}}{{.ContainerID}}:{{.Size}} {{end}}' \
            2>/dev/null \
        | awk -v u=1000 '{for (i=1; i<=NF; i++) {split($i, m, ":");
                          if (u >= m[1] && u < m[1]+m[2]) found=1}}
                         END {exit !found}'
    then echo 1000; else echo 0; fi
}

# Absolute path of this running launcher, following symlinks (portably -- macOS
# readlink has no -f). This is what `gerbil update` overwrites in place.
resolve_self() {
    local src="${BASH_SOURCE[0]}" dir
    while [ -h "$src" ]; do
        dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
        src="$(readlink "$src")"
        case "$src" in /*) ;; *) src="$dir/$src" ;; esac
    done
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    printf '%s/%s\n' "$dir" "$(basename "$src")"
}

# Overwrite the installed launcher with the freshly-fetched one, if it differs.
# Replaces via a temp file + atomic rename so the currently-running script (which
# still holds the old inode open) keeps executing safely.
self_update() {
    local self new tmp
    self="$(resolve_self)"
    new="$(current_dir)/bin/gerbil"
    [ -f "$new" ] || return 0
    # Skip internal copies (e.g. running the versioned source directly); only the
    # user's installed launcher, outside GERBIL_HOME, is worth updating in place.
    case "$self" in "$GERBIL_HOME"/*) return 0 ;; esac
    [ "$self" = "$new" ] && return 0
    cmp -s "$self" "$new" && return 0
    tmp="$self.gerbil-update.$$"
    if cp "$new" "$tmp" 2>/dev/null && chmod +x "$tmp" 2>/dev/null \
            && mv "$tmp" "$self" 2>/dev/null; then
        echo "gerbil: updated launcher at $self" >&2
    else
        rm -f "$tmp" 2>/dev/null
        echo "gerbil: could not overwrite launcher at $self -- update it by hand:" >&2
        echo "  cp '$new' '$self'" >&2
    fi
}

# Verify Docker is installed and the daemon is reachable without sudo, with
# actionable guidance. gerbil's Python side uses the Docker SDK (direct socket),
# which cannot use sudo, so Docker must be usable unprivileged.
check_docker() {
    command -v docker >/dev/null || die "docker is required (https://docs.docker.com/get-docker/).
If Docker is not available, use podman instead:  export GERBIL_SANDBOX=podman"
    local err
    err="$(docker ps 2>&1 >/dev/null)" && return 0
    case "$err" in
        *"permission denied"*)
            die "cannot connect to Docker -- permission denied.

Docker must be usable without sudo (gerbil talks to the daemon via the Docker
SDK, which cannot use sudo). To fix:
  - add yourself to the docker group:  sudo usermod -aG docker \$USER
    then log out and back in (or run: newgrp docker), and verify with:
    docker run hello-world
  - or set up rootless Docker: https://docs.docker.com/engine/security/rootless/
  - or, if Docker is unavailable, use podman:  export GERBIL_SANDBOX=podman"
            ;;
        *"Cannot connect to the Docker daemon"*|*"daemon running"*)
            die "cannot connect to the Docker daemon -- is it running?
Start it (e.g. \`sudo systemctl start docker\`) or open Docker Desktop, then retry.
If Docker is unavailable, use podman instead:  export GERBIL_SANDBOX=podman"
            ;;
        *)
            die "Docker is not usable:
$err"
            ;;
    esac
}

# Podman has no daemon to reach, so `podman info` is the equivalent probe: it
# exercises the local storage config and the rootless user-namespace setup,
# which is where podman actually fails.
check_podman() {
    command -v podman >/dev/null || die "podman is required when GERBIL_SANDBOX=podman \
(https://podman.io/docs/installation).
Unset GERBIL_SANDBOX to use Docker instead."
    local err
    err="$("${CTR[@]}" info 2>&1 >/dev/null)" && return 0
    die "podman is not usable:
$err"
}

check_runtime() {
    case "$SANDBOX_RUNTIME" in
        podman) check_podman ;;
        *)      check_docker ;;
    esac
}

# Build the version-matched sandbox image if it isn't already present. The image
# is tagged with the version's commit; its reference is recorded in versions/.
# Build the version-matched sandbox image if it isn't already present, and set
# SANDBOX_IMAGE to its tag. The tag carries the sandbox uid when it isn't the
# usual 1000, so the two variants never get mistaken for each other.
ensure_image() {
    check_runtime
    local vdir
    vdir="$(current_dir)"
    SANDBOX_UID="$(detect_sandbox_uid)"
    SANDBOX_IMAGE="gerbil-lean-sandbox:$(cat "$CURRENT_FILE")"
    [ "$SANDBOX_UID" = 0 ] && SANDBOX_IMAGE="$SANDBOX_IMAGE-rootuser"
    if ! "${CTR[@]}" image inspect "$SANDBOX_IMAGE" >/dev/null 2>&1; then
        echo "gerbil: building sandbox image $SANDBOX_IMAGE (first time for this version)..." >&2
        [ "$SANDBOX_UID" = 0 ] && echo "gerbil: rootless podman here has no subuid range for uid 1000 --\
 building a sandbox that runs as root inside the container (still your own\
 unprivileged user on the host)." >&2
        "${CTR[@]}" build --build-arg "SANDBOX_UID=$SANDBOX_UID" \
            -t "$SANDBOX_IMAGE" "$vdir/src/lean-sandbox" >&2
        echo "$SANDBOX_IMAGE" > "$vdir/sandbox-image"
    fi
}

# Remove sandbox images left behind by previous versions, so updates don't
# accumulate multi-GB images. Only launcher-built images are swept: those in
# the gerbil-lean-sandbox repo whose tag is a 40-hex commit hash (optionally
# with the -rootuser suffix ensure_image adds) other than the current version's.
# A dev :latest build is never touched. Images still in use by a container fail
# to remove; that is reported and otherwise ignored. Runs after ensure_image,
# which is what sets SANDBOX_IMAGE.
#
# The listing is filtered here rather than with `image ls --filter reference=`
# because the two engines name images differently: podman stores a locally
# built `gerbil-lean-sandbox:X` under the fully-qualified `localhost/`-prefixed
# name, which neither matches docker's bare reference filter nor compares equal
# to the tag we want to keep. Stripping everything up to the last "/" (the
# registry/namespace prefix) normalizes both.
remove_old_images() {
    local keep img name tag
    keep="$SANDBOX_IMAGE"
    "${CTR[@]}" image ls --format '{{.Repository}}:{{.Tag}}' 2>/dev/null \
        | while IFS= read -r img; do
        name="${img##*/}"
        case "$name" in gerbil-lean-sandbox:*) ;; *) continue ;; esac
        [ "$name" = "$keep" ] && continue
        tag="${name##*:}"
        echo "$tag" | grep -qE '^[0-9a-f]{40}(-rootuser)?$' || continue
        if "${CTR[@]}" image rm "$img" >/dev/null 2>&1; then
            echo "gerbil: removed old sandbox image $img" >&2
        else
            echo "gerbil: could not remove old sandbox image $img (in use?)" >&2
        fi
    done
}

usage() {
    # The header comment above, through the trailing requirements note.
    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
}

cmd="${1:-}"
case "$cmd" in
    update)
        new="$(set_current_to_main)"
        ensure_image
        remove_old_images
        self_update
        echo "gerbil: now at $new"
        ;;
    --version|-V|version)
        bootstrap_if_needed
        echo "gerbil $(cat "$CURRENT_FILE")"
        ;;
    run|new-fill)
        bootstrap_if_needed
        ensure_image
        shift
        # Run from the versioned source via uv, but keep the user's cwd (the Lake
        # project) so --at defaults to it. GERBIL_CWD carries it explicitly,
        # GERBIL_SANDBOX_IMAGE selects the version-matched image, and
        # GERBIL_VERSION records the running version in the session log.
        # new-fill takes the same path: after its interactive spec authoring
        # it delegates to run, sandbox and all.
        exec env GERBIL_CWD="$PWD" GERBIL_SANDBOX_IMAGE="$SANDBOX_IMAGE" \
            GERBIL_VERSION="$(cat "$CURRENT_FILE")" \
            uv run --project "$(current_dir)" python -m gerbil "$cmd" "$@"
        ;;
    resume)
        bootstrap_if_needed
        ensure_image
        shift
        # Boots a sandbox to replay + continue a session, so it needs the image.
        exec env GERBIL_CWD="$PWD" GERBIL_SANDBOX_IMAGE="$SANDBOX_IMAGE" \
            GERBIL_VERSION="$(cat "$CURRENT_FILE")" \
            uv run --project "$(current_dir)" python -m gerbil resume "$@"
        ;;
    commit)
        bootstrap_if_needed
        shift
        # commit is host-side (git am); no container/image needed.
        exec env GERBIL_CWD="$PWD" uv run --project "$(current_dir)" \
            python -m gerbil commit "$@"
        ;;
    cleanup)
        bootstrap_if_needed
        shift
        # cleanup is host-side (patch-id checks + file deletion); no container.
        exec env GERBIL_CWD="$PWD" uv run --project "$(current_dir)" \
            python -m gerbil cleanup "$@"
        ;;
    summarize)
        bootstrap_if_needed
        shift
        # summarize just reads the project's .gerbil/*.jsonl logs; no container.
        exec env GERBIL_CWD="$PWD" uv run --project "$(current_dir)" \
            python -m gerbil summarize "$@"
        ;;
    reconstruct-patch)
        bootstrap_if_needed
        ensure_image
        shift
        # Replays a session's tool calls in a container, so it needs the image.
        exec env GERBIL_CWD="$PWD" GERBIL_SANDBOX_IMAGE="$SANDBOX_IMAGE" \
            GERBIL_VERSION="$(cat "$CURRENT_FILE")" \
            uv run --project "$(current_dir)" python -m gerbil reconstruct-patch "$@"
        ;;
    ps|grab)
        bootstrap_if_needed
        shift
        # Host-side registry commands: ps lists ~/.gerbil/running/, grab
        # attaches a viewer to an already-running sandboxed session -- neither
        # boots a container, so no image is needed.
        exec env GERBIL_CWD="$PWD" uv run --project "$(current_dir)" \
            python -m gerbil "$cmd" "$@"
        ;;
    ""|-h|--help|help)
        usage
        ;;
    *)
        die "unknown command '$cmd' (try: run, resume, commit, cleanup, summarize, reconstruct-patch, ps, grab, update, --version)"
        ;;
esac
